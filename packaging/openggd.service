[Unit]
Description=OpenGG Gaming Daemon
Documentation=https://github.com/UPdullah895/opengg
After=graphical-session.target pipewire.service wireplumber.service
Requires=pipewire.service

[Service]
Type=dbus
BusName=org.opengg.Daemon
# Packaged path. `make install` / daemon/scripts/setup.sh rewrite it to
# ~/.local/bin/openggd when installing from source.
ExecStart=/usr/bin/openggd
Restart=on-failure
RestartSec=3
# Security hardening
NoNewPrivileges=true
ProtectHome=read-only
ProtectSystem=strict
# '-' = skip a path that does not exist yet: without it systemd refuses to
# start the unit at all (226/NAMESPACE) on a fresh account.
ReadWritePaths=-%h/.config/opengg -%h/.local/share/opengg -%h/Videos/OpenGG
PrivateTmp=true

[Install]
WantedBy=default.target
