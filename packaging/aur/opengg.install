post_install() {
  echo "OpenGG installed."
  echo ""
  echo "Global hotkeys read the keyboard directly and need the 'input' group:"
  echo "    sudo usermod -aG input \$USER    (then log out and back in)"
  echo ""
  echo "The daemon starts on demand over D-Bus; to start it at login as well:"
  echo "    systemctl --user enable --now openggd.service"
}

post_upgrade() {
  echo "OpenGG upgraded. Restart the daemon to use the new version:"
  echo "    systemctl --user restart openggd.service"
}
